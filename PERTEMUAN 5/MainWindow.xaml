<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,20,15"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>


    <Grid Margin="35">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="709*"/>
            <ColumnDefinition Width="222*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20" Grid.RowSpan="2">

            <StackPanel>

                <TextBlock Text="STUDENT REGISTRATION"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Student Information Management"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFA6E1FF"
                    CornerRadius="12"
                    Padding="25"
                    BorderBrush="#E2E6ED"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Student Information"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,22"/>

                    <TextBlock Text="NIM"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBox x:Name="txtNim"
                             ToolTip="Masukkan NIM"/>

                    <TextBlock Text="Nama Mahasiswa"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBox x:Name="txtNama"
                             ToolTip="Masukkan nama mahasiswa"/>

                    <TextBlock Text="Program Studi"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <ComboBox x:Name="cmbProdi">

                        <ComboBoxItem Content="Teknik Informatika"/>
                        <ComboBoxItem Content="Sistem Informasi"/>
                        <ComboBoxItem Content="Manajemen"/>
                        <ComboBoxItem Content="Akuntansi"/>

                    </ComboBox>

                    <TextBlock Text="Jenis Kelamin"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal">

                        <RadioButton x:Name="rbLaki"
                                     Content="Laki-laki"/>

                        <RadioButton x:Name="rbPerempuan"
                                     Content="Perempuan"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">

                        <Button Content="Simpan"
                                Width="110"
                                Height="40"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                Click="BtnSimpan_Click"/>

                        <Button Content="Reset"
                                Width="110"
                                Height="40"
                                Background="#E5E7EB"
                                Foreground="#374151"
                                BorderThickness="0"
                                Click="BtnReset_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="#FFA6E1FF"
                    CornerRadius="12"
                    Padding="25"
                    BorderBrush="#E2E6ED"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="342*"/>
                        <ColumnDefinition Width="107*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15" Grid.RowSpan="2">

                        <TextBlock Text="Data Mahasiswa"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                        <TextBlock Text="Daftar mahasiswa yang telah terdaftar"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0" IsEnabled="False"/>

                    </StackPanel>

                    <ListBox x:Name="lstMahasiswa"
                             Grid.Row="2"
                             FontSize="13"
                             BorderBrush="#E2E6ED"
                             BorderThickness="1"
                             Background="#FAFBFC"
                             Padding="5" Grid.ColumnSpan="2" Margin="0,0,0,15" Grid.RowSpan="2"/>

                    <Button Grid.Row="4"
                            Content="Hapus Data"
                            Width="120"
                            Height="40"
                            HorizontalAlignment="Left"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnHapus_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>