<UserControl x:Class="CampusFlow.Views.TugasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" VerticalContentAlignment="Center"
                         ToolTip="Cari judul atau mata kuliah"/>
                <ComboBox Grid.Column="1" Width="140" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterPrioritasOptions}" SelectedItem="{Binding FilterPrioritas}"/>
                <ComboBox Grid.Column="2" Width="170" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterStatusOptions}" SelectedItem="{Binding FilterStatus}"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Judul" Binding="{Binding Judul}" Width="*"/>
                            <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding MataKuliahNama}" Width="200"/>
                            <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat=dd MMM yyyy}" Width="120"/>
                            <DataGridTemplateColumn Header="Prioritas" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PrioritasRendahBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Prioritas}" Value="Sedang">
                                                            <Setter Property="Background" Value="{StaticResource PrioritasSedangBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Prioritas}" Value="Tinggi">
                                                            <Setter Property="Background" Value="{StaticResource PrioritasTinggiBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Prioritas}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PrioritasRendahFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Prioritas}" Value="Sedang">
                                                                <Setter Property="Foreground" Value="{StaticResource PrioritasSedangFg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Prioritas}" Value="Tinggi">
                                                                <Setter Property="Foreground" Value="{StaticResource PrioritasTinggiFg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource StatusBelumBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Dalam Proses">
                                                            <Setter Property="Background" Value="{StaticResource StatusProsesBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                            <Setter Property="Background" Value="{StaticResource StatusSelesaiBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusBelumFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dalam Proses">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusProsesFg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusSelesaiFg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Belum ada tugas. Tambahkan melalui form di kanan."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Focusable="False">
            <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Form Tugas" Style="{StaticResource H2}"/>
                    <TextBlock Text="Judul" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding Judul, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Mata Kuliah" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding MataKuliahList}" DisplayMemberPath="Display"
                              SelectedValuePath="Id" SelectedValue="{Binding MataKuliahId}"/>
                    <TextBlock Text="Deskripsi" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding Deskripsi}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Deadline" Style="{StaticResource LabelText}"/>
                    <DatePicker SelectedDate="{Binding Deadline}"/>
                    <TextBlock Text="Prioritas" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding PrioritasOptions}" SelectedItem="{Binding Prioritas}"/>
                    <TextBlock Text="Status" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/>
                    <Button Content="Simpan" Command="{Binding SimpanCommand}" Margin="0,14,0,0"/>
                    <Button Content="Baru" Command="{Binding BaruCommand}" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Hapus" Command="{Binding HapusCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
