<UserControl x:Class="CampusFlow.Views.KalenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Hari Ini" Command="{Binding HariIniCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="&lt; Sebelumnya" Command="{Binding MingguSebelumnyaCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Berikutnya &gt;" Command="{Binding MingguBerikutnyaCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,0"/>
                    <TextBlock Text="{Binding RentangLabel}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <ComboBox HorizontalAlignment="Right" Width="140"
                          ItemsSource="{Binding ViewModeOptions}" SelectedItem="{Binding ViewMode}"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsMingguan, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Minggu}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Margin="3" Padding="8" MinHeight="150">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding NamaHari}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding TanggalLabel}" Style="{StaticResource MutedText}" FontSize="11"/>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Warna}" CornerRadius="6" Padding="6,3" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Waktu}" FontSize="10" Foreground="White" Opacity="0.85"/>
                                                    <TextBlock Text="{Binding Judul}" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="â€”" Style="{StaticResource MutedText}" FontSize="11"
                                           Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisible}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsHarian, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Aktivitas Hari Ini" Style="{StaticResource H2}"/>
                <ItemsControl ItemsSource="{Binding HarianItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Warna}" CornerRadius="2" Width="4"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Waktu}" FontWeight="SemiBold" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                            <Run Text="{Binding Kategori, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Sub, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Tidak ada aktivitas pada tanggal ini." Style="{StaticResource MutedText}"
                           Visibility="{Binding HarianItems.Count, Converter={StaticResource ZeroToVisible}}"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
