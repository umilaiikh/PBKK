<UserControl x:Class="CampusFlow.Views.KegiatanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" VerticalContentAlignment="Center"
                         ToolTip="Cari judul atau lokasi"/>
                <ComboBox Grid.Column="1" Width="180" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterKategoriOptions}" SelectedItem="{Binding FilterKategori}"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Judul" Binding="{Binding Judul}" Width="*"/>
                            <DataGridTemplateColumn Header="Kategori" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource KatPribadiBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kategori}" Value="Organisasi">
                                                            <Setter Property="Background" Value="{StaticResource KatOrganisasiBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kategori}" Value="Belajar Mandiri">
                                                            <Setter Property="Background" Value="{StaticResource KatBelajarBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Kategori}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat=dd MMM yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu}" Width="140"/>
                            <DataGridTextColumn Header="Lokasi" Binding="{Binding Lokasi}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Belum ada kegiatan. Tambahkan melalui form di kanan."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Focusable="False">
            <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Form Kegiatan" Style="{StaticResource H2}"/>
                    <TextBlock Text="Judul" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding Judul, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Kategori" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding KategoriOptions}" SelectedItem="{Binding Kategori}"/>
                    <TextBlock Text="Tanggal" Style="{StaticResource LabelText}"/>
                    <DatePicker SelectedDate="{Binding Tanggal}"/>
                    <TextBlock Text="Waktu Mulai" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding WaktuOptions}" SelectedItem="{Binding WaktuMulai}"/>
                    <TextBlock Text="Waktu Selesai" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding WaktuOptions}" SelectedItem="{Binding WaktuSelesai}"/>
                    <TextBlock Text="Lokasi" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding Lokasi}"/>
                    <TextBlock Text="Catatan" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding Catatan}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Simpan" Command="{Binding SimpanCommand}" Margin="0,14,0,0"/>
                    <Button Content="Baru" Command="{Binding BaruCommand}" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Hapus" Command="{Binding HapusCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
